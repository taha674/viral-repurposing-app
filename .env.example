# Copy to .env.local and fill in. .env* is git-ignored — never commit real keys.
# On Railway, set these as project Variables instead — never commit them.

# --- Postgres ---
# Railway sets this automatically once you attach its Postgres addon to this
# service. For local dev, point at a local Postgres instance instead.
DATABASE_URL=

# --- App password gate (Railway only — no gate in local dev unless set) ---
# Single shared password for the whole app. Generate one with e.g.
# `openssl rand -base64 18`.
APP_PASSWORD=

# --- Scheduled scan (Railway only) ---
# Bearer secret the Railway cron service presents to POST /api/cron/scan.
# Generate one with e.g. `openssl rand -base64 24`.
CRON_SECRET=

# --- Apify (Instagram Reel Scraper: apify/instagram-reel-scraper) ---
# Get a token at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Actor id used for both the scan (transcript off) and transcript pull (transcript on).
APIFY_INSTAGRAM_ACTOR=apify/instagram-reel-scraper

# Hashtag discovery actor (2026-08-24) — separate actor, used by tracked
# hashtags on the Discovery Sources page. Not live-verified the way the
# reel-scraper actor above is; built against Apify's published schema docs.
APIFY_INSTAGRAM_HASHTAG_ACTOR=apify/instagram-hashtag-scraper

# --- Gemini (adaptation step) ---
# Get a key at https://aistudio.google.com/apikey (starts with "AIza").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- ElevenLabs (voiceover step) ---
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# The existing Cyrus v4 custom voice id (from the ElevenLabs voice library).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
# Root-level folder voiceovers are saved into, as {reel_id}_{date}/voiceover.mp3,
# for manual pickup before the HeyGen step. Defaults to Automation/reels/
# locally. On Railway, set this to the mount path of the attached volume
# (e.g. /data/reels) so voiceovers survive redeploys.
REELS_OUTPUT_DIR=
# Auto-purge threshold, in MB, for REELS_OUTPUT_DIR. Checked before every
# write that grows the volume; crossing it reclaims archived reels' folders
# and already-burned reels' source videos (never active/undownloaded work).
# See lib/retention.ts and service.ts#autoPurgeIfOverThreshold.
VOLUME_PURGE_THRESHOLD_MB=500

# --- Tunables (safe defaults; override only if needed) ---
# View threshold used by the "paste a URL" manual add and the hashtag scan.
# NOT applied to the account scan any more (2026-09-14) — that scan ranks by
# views instead of a floor. See lib/config.ts#viewThreshold.
VIEW_THRESHOLD=500000
# Posts pulled per account per scan sweep (metadata only, cheap) — high
# enough to approximate the account's available history.
SCAN_POSTS_PER_ACCOUNT=200
# Size of each round-robin chunk taken from an account (highest-viewed
# first) while the scan works toward SCAN_MIN_NEW_REELS_PER_RUN below.
SCAN_BATCH_PER_ACCOUNT=2
# Floor on total new reels the account scan tries to gather in one run,
# across all active accounts, round-robining SCAN_BATCH_PER_ACCOUNT-sized
# chunks per account until this is hit or every account runs dry.
SCAN_MIN_NEW_REELS_PER_RUN=15
# Top reels pulled per hashtag during a hashtag scan, before the view-count
# and talking-head filters run.
SCAN_POSTS_PER_HASHTAG=30
# Hard caps — protect against runaway paid-API spend.
APIFY_MAX_RETRIES=1
GEMINI_MAX_RETRIES=1
ADAPT_MAX_OUTPUT_TOKENS=2000
# Separate budget for the publish-pack call (caption / hashtags / cover text
# hook). Its own knob so tuning one call never squeezes the other.
PUBLISH_PACK_MAX_OUTPUT_TOKENS=1800
ELEVENLABS_MAX_RETRIES=1
# eleven_v3 is slow — a too-short timeout aborts real (in-progress) generations
# client-side and can cause a double-charge on retry. 120s default.
ELEVENLABS_TIMEOUT_MS=120000
# Budget guard: blocks voiceover generation for scripts longer than this.
VOICEOVER_MAX_CHARS=6000

# --- Subtitle burn-in (local ffmpeg + local Whisper — no API key needed) ---
# Only used as a fallback when a reel has no stored ElevenLabs alignment
# (e.g. a voiceover generated before this feature existed).
WHISPER_MODEL=Xenova/whisper-base.en
CAPTIONS_MAX_VIDEO_MB=500
CAPTIONS_TRANSCRIBE_TIMEOUT_MS=180000
CAPTIONS_FFMPEG_TIMEOUT_MS=180000

# --- Punch-in zoom (burned in the same pass as the subtitles, before them) ---
# Set to off to fall back to the plain subtitle burn.
PUNCH_IN=on
# Zoom per level as a fraction of the base frame. Bracketed against real
# renders: 0.08 read as too timid, 0.11 as too strong.
PUNCH_IN_STEP=0.09
# How many steps a climb may take. Three read as too much, so a cycle is at
# most two punches and tops out at 1.18x.
PUNCH_IN_MAX_LEVEL=2
# A re-frame holds at least this long, and at least until the caption it
# landed on finishes - whichever is later.
PUNCH_IN_MIN_HOLD=0.5
# A word gap this long counts as a phrase break (word timings, not caption
# line boundaries — line gaps are mostly zero and carry no rhythm).
PUNCH_IN_MIN_GAP=0.10
# Beat boundaries are relative to the video's own pause distribution.
PUNCH_IN_BOUNDARY_PCTL=0.50
# Beats must be long enough to hold more than one phrase break, which is what
# gives the climbs varied depth instead of a uniform sawtooth.
PUNCH_IN_MIN_BEAT=4.5
PUNCH_IN_MAX_BEAT=8.0

# --- Instagram DM bot (2026-09-13) ---
# Chat control layer: forward a reel to the bot's Instagram account, walk it
# through adaptation/voiceover/(manual HeyGen)/subtitle-burn/publish-pack via
# DM. Additive — the web UI keeps working unchanged. See lib/instagram.ts.
#
# Access token for the bot's Instagram professional account (Instagram API
# with Instagram Login — no linked Facebook Page needed). Get a long-lived
# token via a Meta developer app's Instagram product setup page.
INSTAGRAM_ACCESS_TOKEN=
# The bot account's Instagram Business Account ID (same setup page).
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_API_VERSION=v21.0
# Any random string you choose — must match what you enter in the Meta app's
# webhook configuration (proves the GET verification handshake is legitimate).
INSTAGRAM_VERIFY_TOKEN=
# App Settings -> Basic -> App Secret. Verifies the X-Hub-Signature-256 header
# on every incoming webhook POST really came from Meta.
INSTAGRAM_APP_SECRET=
# The Instagram-scoped ID (IGSID) of the one account allowed to control the
# bot — every other sender is silently dropped. Found by messaging the bot
# once and reading `sender.id` off the resulting webhook payload/log.
INSTAGRAM_OWNER_IGSID=
# Random secret signing the short-lived /api/instagram/media/[token] links
# Meta's servers fetch to deliver a finished video or voiceover in-chat.
# Generate one with e.g. `openssl rand -base64 24`.
INSTAGRAM_MEDIA_TOKEN_SECRET=
# Hard cap on retrying a failed Instagram message SEND (delivery only — never
# the underlying pipeline call that triggered the message).
INSTAGRAM_MAX_RETRIES=1
INSTAGRAM_TIMEOUT_MS=15000
# This deployment's public origin (e.g. https://viral-repurposing-app-production.up.railway.app),
# used to build the signed media links above.
PUBLIC_BASE_URL=

# --- MCP server (/api/mcp) for Hermes / agentic callers ---
# Bearer token the agent sends as "Authorization: Bearer <token>". Generate
# with: openssl rand -hex 32. The endpoint stays closed while this is unset.
MCP_API_TOKEN=
# Hard daily caps on agent-triggered paid calls (adapt/voiceover/publish
# pack/transcript, and scans respectively). Over the cap = error, no retry.
MCP_DAILY_PAID_CALL_CAP=25
MCP_DAILY_SCAN_CAP=2
